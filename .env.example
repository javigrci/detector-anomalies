# Copia este archivo a .env y ajusta los valores. .env NO se versiona.
# Contrato: specs/000-base/contracts/environment.md

APP_ENV=development
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT_S=2
API_PORT=8000

# Base de datos de Compose. La clave debe ser apta para URL (sin @ : / ? # %).
POSTGRES_USER=anomaly
POSTGRES_PASSWORD=change-me-use-a-url-safe-password
POSTGRES_DB=anomaly

# Solo para ejecutar fuera de Compose (por ejemplo, `uv run python -m security_anomaly`).
# Dentro de Compose la URL se compone a partir de las variables de rol. Desde el incremento 2 es la
# URL del rol de aplicación `anomaly_app` (solo insertar y consultar).
DATABASE_URL=postgresql+psycopg://anomaly_app:change-me-app-url-safe-password@localhost:5432/anomaly

# --- Ingesta (incremento 1) ---
# Clave secreta del HMAC que seudonimiza los usuarios y deriva los identificadores del adaptador.
# Mínimo 32 caracteres aleatorios (por ejemplo: openssl rand -hex 32). El marcador `change-me` se
# rechaza a propósito: hay que sustituirlo. Rotarla cambia seudónimos e identificadores.
PSEUDONYM_KEY=change-me-use-at-least-32-random-characters

# Límites y rango de fechas (valores por defecto; todos opcionales).
INGEST_MAX_FILE_BYTES=10485760
INGEST_MAX_EVENTS_PER_BATCH=10000
INGEST_MAX_EVENTS_PER_DATASET=100000
INGEST_MAX_FIELD_LENGTH=256
INGEST_TIMESTAMP_MIN=2000-01-01T00:00:00+00:00
INGEST_TIMESTAMP_MAX=2100-01-01T00:00:00+00:00

# --- Persistencia (incremento 2) ---
# Tres roles de BD con contraseñas DISTINTAS entre sí (≥ 12 caracteres, aptas para URL: sin
# @ : / ? # % y sin el marcador `change-me`, que se rechaza a propósito). Genera cada una con
# `openssl rand -hex 12`. Contrato: specs/002-persistence/contracts/environment.md
MIGRATOR_DB_PASSWORD=change-me-migrator-url-safe-password
APP_DB_PASSWORD=change-me-app-url-safe-password
MAINT_DB_PASSWORD=change-me-maint-url-safe-password

# Una URL por operación: cada una solo conoce sus credenciales. Dentro de Compose se componen solas.
# Rol propietario del esquema (migraciones con Alembic).
MIGRATION_DATABASE_URL=postgresql+psycopg://anomaly_migrator:change-me-migrator-url-safe-password@localhost:5432/anomaly
# Rol de mantenimiento (solo borrar eventos, para la purga).
MAINTENANCE_DATABASE_URL=postgresql+psycopg://anomaly_maint:change-me-maint-url-safe-password@localhost:5432/anomaly
# Administrador de PostgreSQL; solo para `provision-roles`.
ADMIN_DATABASE_URL=postgresql+psycopg://anomaly:change-me-use-a-url-safe-password@localhost:5432/anomaly

# Retención (días, ≥ 1, contada desde la ingesta) y paginación.
RETENTION_DAYS=90
QUERY_DEFAULT_LIMIT=100
QUERY_MAX_LIMIT=1000
