# Copia este archivo a .env y ajusta los valores. .env NO se versiona.
# Contrato: specs/000-base/contracts/environment.md

APP_ENV=development
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT_S=2
API_PORT=8000

# Base de datos de Compose. La clave debe ser apta para URL (sin @ : / ? # %).
POSTGRES_USER=anomaly
POSTGRES_PASSWORD=change-me-use-a-url-safe-password
POSTGRES_DB=anomaly

# Solo para ejecutar fuera de Compose (por ejemplo, `uv run python -m security_anomaly`).
# Dentro de Compose la URL se compone a partir de las variables POSTGRES_*.
DATABASE_URL=postgresql+psycopg://anomaly:change-me-use-a-url-safe-password@localhost:5432/anomaly

# --- Ingesta (incremento 1) ---
# Clave secreta del HMAC que seudonimiza los usuarios y deriva los identificadores del adaptador.
# Mínimo 32 caracteres aleatorios (por ejemplo: openssl rand -hex 32). El marcador `change-me` se
# rechaza a propósito: hay que sustituirlo. Rotarla cambia seudónimos e identificadores.
PSEUDONYM_KEY=change-me-use-at-least-32-random-characters

# Límites y rango de fechas (valores por defecto; todos opcionales).
INGEST_MAX_FILE_BYTES=10485760
INGEST_MAX_EVENTS_PER_BATCH=10000
INGEST_MAX_EVENTS_PER_DATASET=100000
INGEST_MAX_FIELD_LENGTH=256
INGEST_TIMESTAMP_MIN=2000-01-01T00:00:00+00:00
INGEST_TIMESTAMP_MAX=2100-01-01T00:00:00+00:00
